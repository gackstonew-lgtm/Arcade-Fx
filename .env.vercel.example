# ============================================================
# ARCADE FX — VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# Primary Target Production URL: https://arcadefx.live
# File: .env.vercel.example (Template / Source of Truth)
# ============================================================
#
# INSTRUCTIONS FOR VERCEL DEPLOYMENT:
# Copy these key-value pairs into Vercel dashboard under:
# Project -> Settings -> Environment Variables -> Production
#
# Do NOT commit real secret values to Git repositories.

# ============================================================
# 1. DATABASE & PERSISTENCE (POSTGRESQL / SUPABASE)
# ============================================================

# PostgreSQL Connection String (Direct or Supabase Transaction Pooler)
# CONSUMED BY: netlify/functions/lib/db.mjs, scripts/migrate.mjs, scripts/import-legacy-sqlite.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Yes (Primary DB adapter when configured)
DATABASE_URL=postgresql://postgres.ykkzfnrndlatvpfsnurk:YOUR_PASSWORD_HERE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Database SSL Connection Requirement ('true' or 'false')
# CONSUMED BY: netlify/functions/lib/db.mjs, scripts/migrate.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes (Defaults to true in application code)
DATABASE_SSL=true


# ============================================================
# 2. SUPABASE INTEGRATION & AUTHENTICATION
# ============================================================

# Supabase Project REST API Base URL
# CONSUMED BY: netlify/functions/lib/db.mjs, supabase/functions/*, client scripts
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes
SUPABASE_URL=https://ykkzfnrndlatvpfsnurk.supabase.co

# Supabase Client-side Anonymous API Key
# CONSUMED BY: netlify/functions/lib/db.mjs, frontend scripts (index.html, admin/src/adminApi.js)
# TYPE: PUBLIC / NON-SENSITIVE (Exposed safely to browser)
# MANDATORY: Yes
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inlra3pmbnJuZGxhdHZwZnNudXJrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5NTMzNzUsImV4cCI6MjEwMjUyOTM3NX0.DPp9s3o1MQtGoVC52GR-woEJszvvRlQntz-6j7usBJw

# Supabase Server-side Service Role Secret Key (Bypasses Row Level Security)
# CONSUMED BY: netlify/functions/lib/db.mjs, supabase/functions/*
# TYPE: SERVER-SIDE SECRET (NEVER EXPOSE IN FRONTEND OR VITE_* VARIABLES)
# MANDATORY: Yes (Required for admin DB overrides & serverless operations)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE


# ============================================================
# 3. SIGNAL ENGINE INTEGRATION
# ============================================================

# BM Forex Live VPS Signal Engine Base URL (Proxy Target)
# CONSUMED BY: netlify/functions/lib/bm-live-engine.mjs, netlify/functions/api.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes (Defaults to http://157.173.193.93:5000 if omitted)
# NOTE: No API key or authentication is currently required by the signal engine VPS.
SIGNAL_ENGINE_URL=http://157.173.193.93:5000


# ============================================================
# 4. GOLD / PRECIOUS METALS MARKET DATA (GOLDAPI.IO)
# ============================================================

# GoldAPI.io REST API Token (x-access-token for XAU/USD, XAG/USD, XPT/USD, XPD/USD)
# CONSUMED BY: netlify/functions/lib/bm-live-engine.mjs, netlify/functions/lib/goldapi-data.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Optional (App falls back to reference pricing if unconfigured)
GOLD_API_KEY=YOUR_GOLD_API_KEY_HERE

# Legacy GoldAPI Key Name (Supported for backward compatibility)
# CONSUMED BY: netlify/functions/lib/bm-live-engine.mjs, netlify/functions/lib/goldapi-data.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Optional (Fallback if GOLD_API_KEY is unset)
GOLDAPI_API_KEY=YOUR_GOLD_API_KEY_HERE


# ============================================================
# 5. TWELVE DATA MARKET DATA INTEGRATION
# ============================================================

# Twelve Data REST API Key (Used for multi-asset quotes via /quote endpoint)
# CONSUMED BY: netlify/functions/lib/twelve-data.mjs, netlify/functions/lib/ecb-data.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Optional (App falls back to ECB reference rates if unconfigured)
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY_HERE

# Twelve Data Base Endpoint URL
# CONSUMED BY: netlify/functions/lib/twelve-data.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes (Defaults to https://api.twelvedata.com if omitted)
# ENDPOINTS USED: /quote (e.g. https://api.twelvedata.com/quote?symbol=EUR/USD&apikey=...)
TWELVE_DATA_BASE_URL=https://api.twelvedata.com


# ============================================================
# 6. PAYHERO / M-PESA PAYMENT INTEGRATION
# ============================================================

# Primary PayHero Channel ID (Dedicated to Arcade FX M-Pesa STK Push)
# CONSUMED BY: netlify/functions/payhero-stk.mjs
# TYPE: SERVER-SIDE SECRET / CONFIGURATION
# MANDATORY: Yes (Required for M-Pesa payment initiation)
PAYHERO_ARCADEFX_CHANNEL_ID=YOUR_PAYHERO_ARCADEFX_CHANNEL_ID_HERE

# Legacy PayHero Channel ID (Supported for backward compatibility fallback)
# CONSUMED BY: netlify/functions/payhero-stk.mjs
# TYPE: SERVER-SIDE SECRET / CONFIGURATION
# MANDATORY: Optional (Fallback if PAYHERO_ARCADEFX_CHANNEL_ID is unset)
PAYHERO_CHANNEL_ID=YOUR_PAYHERO_CHANNEL_ID_HERE

# PayHero Basic Auth API Key
# CONSUMED BY: netlify/functions/payhero-stk.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Yes
PAYHERO_API_KEY=YOUR_PAYHERO_API_KEY_HERE

# PayHero Basic Auth API Secret
# CONSUMED BY: netlify/functions/payhero-stk.mjs
# TYPE: SERVER-SIDE SECRET
# MANDATORY: Yes
PAYHERO_SECRET=YOUR_PAYHERO_SECRET_HERE

# PayHero Asynchronous Callback/Webhook URL
# CONSUMED BY: netlify/functions/payhero-stk.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes (Target Vercel production endpoint)
PAYHERO_CALLBACK_URL=https://arcadefx.live/api/payhero-webhook


# ============================================================
# 7. ADMINISTRATOR AUTHORIZATION
# ============================================================

# Master Administrator Email Address (Granted permanent super-admin privileges)
# CONSUMED BY: netlify/functions/lib/http.mjs (verifyAdmin)
# TYPE: SERVER-SIDE CONFIGURATION / SENSITIVE
# MANDATORY: Yes
ADMIN_EMAIL=admin@arcadefx.live


# ============================================================
# 8. CORS & PRODUCTION ORIGIN SECURITY
# ============================================================

# Primary Production Origin URL for Access-Control-Allow-Origin Headers
# CONSUMED BY: netlify/functions/lib/http.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Yes
ALLOWED_ORIGIN=https://arcadefx.live

# Multiple Allowed Origins (Comma-separated list; takes precedence over ALLOWED_ORIGIN if set)
# CONSUMED BY: netlify/functions/lib/http.mjs
# TYPE: PUBLIC / NON-SENSITIVE
# MANDATORY: Optional (Combined with DEFAULT_ALLOWED_ORIGINS in code)
ALLOWED_ORIGINS=https://arcadefx.live,https://admin.arcadefx.live


# ============================================================
# 9. SUPABASE EDGE FUNCTIONS / EXTENDED INTEGRATIONS (SUPABASE-ONLY)
# ============================================================

# Korapay Merchant Secret Key (M-Pesa charges & payouts in Supabase Edge Functions)
# CONSUMED BY: supabase/functions/create-deposit/index.ts, supabase/functions/create-withdrawal/index.ts
# TYPE: SUPABASE SECRETS ONLY (Configure via `supabase secrets set KORA_SECRET_KEY=...`)
# MANDATORY: Optional (Only if Korapay M-Pesa gateway is active)
KORA_SECRET_KEY=YOUR_KORA_SECRET_KEY_HERE

# Korapay Webhook Signature Secret (HMAC verification for incoming Kora webhooks)
# CONSUMED BY: supabase/functions/kora-webhook/index.ts
# TYPE: SUPABASE SECRETS ONLY (Configure via `supabase secrets set KORA_WEBHOOK_SECRET=...`)
# MANDATORY: Optional (Only if Korapay webhooks are used)
KORA_WEBHOOK_SECRET=YOUR_KORA_WEBHOOK_SECRET_HERE
